# Supabase project (Settings → API). The publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Comma-separated list of emails allowed to sign in.
ALLOWED_EMAILS=you@example.com
# Optional: lets Project Organiser sort your inbox with Claude (console.anthropic.com → API keys).
# Server-only; never prefix with NEXT_PUBLIC_. Without it, inbox items are saved and wait.
ANTHROPIC_API_KEY=
